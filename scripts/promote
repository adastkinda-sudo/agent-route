#!/bin/zsh
# 把本仓库的稳定版同步到 ~/.claude：检查通过后备份线上文件，再覆盖。
# 只同步代码和配置；线上的 logs/、state/、backup/、config.local.json 不动。
# 用法：scripts/promote [--dry-run] [--force] [--skip-push-check]
#       scripts/promote --rollback [备份目录名] [--dry-run] [--force]
set -euo pipefail

repo=${0:A:h:h}
dest=${AGENT_ROUTE_DEST:-$HOME/.claude/agent-route}
dest=${dest:A}
agents_dest=${CLAUDE_AGENTS_DEST:-$HOME/.claude/agents}
skills_dest=${CLAUDE_SKILLS_DEST:-$HOME/.claude/skills}
dry=0
force=0
skip_push_check=0
rollback=0
rollback_name=''

while (( $# )); do
  case "$1" in
    --dry-run) dry=1 ;;
    --force) force=1 ;;
    --skip-push-check) skip_push_check=1 ;;
    --rollback)
      rollback=1
      if (( $# > 1 )) && [[ "$2" != --* ]]; then
        rollback_name=$2
        shift
      fi
      ;;
    --rollback=*) rollback=1; rollback_name=${1#--rollback=} ;;
    *) print -u2 "用法错误：未知参数 $1"; exit 2 ;;
  esac
  shift
done

items=(bin test config.json agents.json)
# 仓库内路径 -> 线上路径
typeset -A extras=(
  claude-agents/tier3.md "$agents_dest/tier3.md"
  claude-skills/agent-route/SKILL.md "$skills_dest/agent-route/SKILL.md"
)

git_run() {
  git -C "$repo" "$@"
}

print_diff() {
  print "差异（线上 -> 仓库）："
  for item in $items; do
    diff -rq "$dest/$item" "$repo/$item" 2>/dev/null || true
  done
  for src target in ${(kv)extras}; do
    diff -q "$target" "$repo/$src" 2>/dev/null || true
  done
}

check_clean() {
  local worktree_status
  worktree_status=$(git_run status --porcelain)
  if [[ -n "$worktree_status" ]]; then
    print -u2 "检查失败：工作区不干净"
    print -u2 -- "$worktree_status"
    return 1
  fi
  print "检查通过：工作区干净"
}

check_pushed() {
  local branch remote_ref
  branch=$(git_run branch --show-current)
  if [[ -z "$branch" ]]; then
    print -u2 "检查失败：当前 HEAD 没有分支"
    return 1
  fi
  if ! git_run fetch origin; then
    print -u2 "检查失败：git fetch origin 失败；网络不可用时可用 --skip-push-check 跳过"
    return 1
  fi
  remote_ref="origin/$branch"
  if ! git_run rev-parse --verify "$remote_ref" >/dev/null 2>&1; then
    print -u2 "检查失败：找不到 $remote_ref"
    return 1
  fi
  if ! git_run merge-base --is-ancestor HEAD "$remote_ref"; then
    print -u2 "检查失败：HEAD 尚未推送到 $remote_ref"
    return 1
  fi
  print "检查通过：HEAD 已推送到 $remote_ref"
}

running_dispatch() {
  local target=$1 pids pid
  pids=$(pgrep -f -- "$target" || true)
  for pid in ${(f)pids}; do
    [[ -z "$pid" || "$pid" == $$ ]] && continue
    print -u2 "PID $pid 匹配线上派发：$target"
    return 0
  done
  return 1
}

check_no_running() {
  local target
  for target in "$dest/bin/agent-route" "$dest/bin/monitor-loop" "$dest/bin/watch-alert"; do
    if running_dispatch "$target"; then
      print -u2 "检查失败：线上仍有派发进程运行"
      return 1
    fi
  done
  print "检查通过：没有正在运行的线上派发"
}

check_selftest() {
  if ! (cd "$repo" && "$repo/bin/agent-route" selftest); then
    print -u2 "检查失败：bin/agent-route selftest 未通过"
    return 1
  fi
  print "检查通过：bin/agent-route selftest"
}

run_sync_checks() {
  if (( force )); then
    print "检查跳过（--force）：工作区、推送状态和线上运行状态"
  else
    check_clean || return 1
    if (( skip_push_check )); then
      print "检查跳过（--skip-push-check）：HEAD 推送状态"
    else
      check_pushed || return 1
    fi
    check_no_running || return 1
  fi
  check_selftest || return 1
}

latest_backup() {
  local names
  [[ -d "$dest/backup" ]] || return 1
  names=(${(f)"$(find "$dest/backup" -mindepth 1 -maxdepth 1 -type d -name 'promote-*' -print 2>/dev/null | sort)"})
  (( ${#names} )) || return 1
  print -r -- "${names[-1]:t}"
}

resolve_rollback_backup() {
  local name=$rollback_name
  if [[ -z "$name" ]]; then
    name=$(latest_backup) || {
      print -u2 "回滚失败：没有可用的 promote-* 备份"
      return 1
    }
  fi
  [[ "$name" != */* && "$name" == promote-* ]] || {
    print -u2 "回滚失败：备份目录名必须是 promote-*"
    return 1
  }
  rollback_name=$name
  rollback_dir="$dest/backup/$name"
  [[ -d "$rollback_dir" ]] || {
    print -u2 "回滚失败：找不到备份 $rollback_name"
    return 1
  }
}

make_backup_dir() {
  local stamp candidate n
  stamp=$(date +%Y%m%d-%H%M%S)
  candidate="$dest/backup/promote-$stamp"
  n=1
  while [[ -e "$candidate" ]]; do
    candidate="$dest/backup/promote-$stamp-$(printf '%02d' $n)"
    (( n++ ))
  done
  mkdir -p "$candidate"
  print -r -- "$candidate"
}

backup_current() {
  local backup=$1 item src target
  for item in $items VERSION; do
    [[ -e "$dest/$item" ]] && cp -Rp "$dest/$item" "$backup/"
  done
  for src target in ${(kv)extras}; do
    if [[ -e "$target" ]]; then
      mkdir -p "$backup/${src:h}"
      cp -p "$target" "$backup/$src"
    fi
  done
}

copy_tree() {
  local item
  for item in $items; do
    rm -rf "$dest/.$item.new" "$dest/.$item.old"
    cp -Rp "$repo/$item" "$dest/.$item.new"
    [[ -e "$dest/$item" ]] && mv "$dest/$item" "$dest/.$item.old"
    mv "$dest/.$item.new" "$dest/$item"
    rm -rf "$dest/.$item.old"
  done
  for src target in ${(kv)extras}; do
    mkdir -p "${target:h}"
    rm -f "$target.new"
    cp -p "$repo/$src" "$target.new"
    mv "$target.new" "$target"
  done
}

write_version() {
  local sha branch stamped describe temporary
  sha=$(git_run rev-parse HEAD)
  branch=$(git_run branch --show-current)
  stamped=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  describe=$(git_run describe --always --dirty)
  # git ref 名允许空格，转义这几个 JSON 特殊字符后写入单行 VERSION。
  sha=${sha//\\/\\\\}; sha=${sha//\"/\\\"}
  branch=${branch//\\/\\\\}; branch=${branch//\"/\\\"}
  stamped=${stamped//\\/\\\\}; stamped=${stamped//\"/\\\"}
  describe=${describe//\\/\\\\}; describe=${describe//\"/\\\"}
  temporary="$dest/.VERSION.new"
  print -r -- "{\"commit\":\"$sha\",\"branch\":\"$branch\",\"time\":\"$stamped\",\"describe\":\"$describe\"}" >| "$temporary"
  mv "$temporary" "$dest/VERSION"
}

restore_backup() {
  local item src target
  for item in $items VERSION; do
    rm -rf "$dest/$item"
    [[ -e "$rollback_dir/$item" ]] && cp -Rp "$rollback_dir/$item" "$dest/"
  done
  for src target in ${(kv)extras}; do
    rm -f "$target"
    [[ -e "$rollback_dir/$src" ]] || continue
    mkdir -p "${target:h}"
    cp -p "$rollback_dir/$src" "$target"
  done
}

prune_backups() {
  local keep=${AGENT_ROUTE_KEEP_BACKUPS:-10} names i
  [[ "$keep" == <-> && $keep -ge 0 ]] || keep=10
  [[ -d "$dest/backup" ]] || return 0
  names=(${(f)"$(find "$dest/backup" -mindepth 1 -maxdepth 1 -type d -name 'promote-*' -print 2>/dev/null | sort)"})
  while (( ${#names} > keep )); do
    rm -rf -- "${names[1]}"
    names=(${names[2,-1]})
  done
}

print_diff

if (( rollback )); then
  if (( force )); then
    print "检查跳过（--force）：线上运行状态"
  else
    check_no_running || exit 1
  fi
  resolve_rollback_backup || exit 1
  print "回滚来源：$rollback_name"
  if (( dry )); then
    print "dry-run：不会写入线上目录"
    exit 0
  fi
  mkdir -p "$dest/backup"
  current_backup=$(make_backup_dir)
  backup_current "$current_backup"
  restore_backup
  prune_backups
  print "已回滚到 $rollback_name；当前线上文件备份在 $current_backup"
  exit 0
fi

run_sync_checks || exit 1
if (( dry )); then
  print "dry-run：不会写入线上目录"
  exit 0
fi

mkdir -p "$dest" "$dest/backup"
backup=$(make_backup_dir)
backup_current "$backup"
copy_tree
write_version
prune_backups
print "已同步到 $dest，备份在 $backup"
