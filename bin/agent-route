function logCodexFailure(tail, code, telemetry = {}) {
  const classification = classifyCodexFailure(tail, code, telemetry);
  log(`failure class: ${classification.category}`);
  log(`source: ${classification.source}`);
  return classification;
}
function beginRound() {
  const suffix = `${fixRound ? `-fix${fixRound}` : ''}${attemptSerial ? `-attempt${attemptSerial}` : ''}`;
  base = path.join(LOG_DIR, `${stamp}-${tier}-${process.pid}${suffix}`);
  logPath = `${base}.log`;
  fullPromptPath = `${base}.prompt.md`;
  reportPath = `${base}.report.md`;
  startedAt = Date.now();
  verifyResult = null;
  codexTokens = null;
  reconnectCount = 0;
  capacityCount = 0;
  reconnectLines = [];
  stderrDiagnosticLines = [];
  codexStall = { count: 0, seconds: 0 };
  progressRecord = null;
  // 监控总结只要两行，不需要报告文件和执行规则
  const modeLine = write
    ? '模式: 可修改文件'
    : monitor ? '模式: 只读，不要修改任何文件' : `模式: 只读，除报告文件 ${reportPath} 外不要修改任何文件`;
  const reportRule = write
    ? `汇报放不下的长明细才写进报告文件 ${reportPath}；写了就在验证栏末尾注明"明细见报告"，不写报告路径，也不写进偏差或遗留问题。`
    : `调查结论必须写在结论栏；超过约 25 行时将完整明细写进报告文件 ${reportPath}；结论栏保留要点并注明"明细见报告"，不写报告路径，也不写进偏差或遗留问题。`;
  // 固定部分用 XML 标签分块，执行方据此区分模式、规则、任务和输出约定
  const footer = (!write && !monitor ? READ_ONLY_REPORT_FOOTER : REPORT_FOOTER).replace(/^\n+|\s+$/g, '');
  fullPrompt = [
    `<execution_mode>\n${monitor ? modeLine : `${modeLine}\n${reportRule}`}\n</execution_mode>`,
    ...(monitor ? [] : [`<execution_rules>\n${RULES}\n</execution_rules>`]),
    `<task>\n${promptText.replace(/\s+$/, '')}\n</task>`,
    `<output_contract>\n${footer}\n</output_contract>`,
  ].join('\n\n') + '\n';
  // 原生 subagent 在主会话目录下启动，需要在文件里写明工作目录
  fs.writeFileSync(fullPromptPath, `工作目录: ${cwd}（所有命令都在这个目录下执行）\n${fullPrompt}`);
  log(`tier: ${tier}\ncwd: ${cwd}\nwrite: ${write}\nmodel: ${model}\neffort: ${effort}\nprompt-file: ${fullPromptPath}\ntime: ${new Date(startedAt).toISOString()}\nmonitor: ${monitor}\nprompt_chars: ${charCount(promptText)}`);
  if (dispatchContext.enabled) log(`providers: ${JSON.stringify({ codex: safeRouteContext(dispatchContext.codex), claude: safeRouteContext(dispatchContext.claude) })}`);
  if (providerChange) log(`provider-change: ${JSON.stringify(providerChange)}`);
  if (resumeArg !== null) log(`resumed: ${resumeArg}`);
  if (attemptPhase !== null) log(`attempt: ${attemptPhase}`);
}

let reconnectCount = 0;
let capacityCount = 0;
let reconnectLines = [];
let stderrDiagnosticLines = [];
let codexStall = { count: 0, seconds: 0 };

function isCodexStderrDiagnostic(line) {
  if (/^(?:error|warning|fatal|http\s+\d{3}|unexpected status|selected model|you[’']ve hit|reconnecting|stream disconnected|retry|at capacity|model(?:[_\s-]*(?:not[_\s-]*found|does not exist|unsupported))|unauthorized|internal server error|service unavailable|status\s+\d{3})\b/i.test(line)) {
    return true;
  }
  if (!line.startsWith('{')) return false;
  try {
    const value = JSON.parse(line);
    return Boolean(value && typeof value === 'object' && (value.error || value.code || value.status));
  } catch { return false; }
}

function observeCodexOutput(chunk) {
  for (const line of String(chunk).split(/\r?\n/).map((value) => value.trim()).filter(Boolean)) {
    if (isCodexStderrDiagnostic(line)) {
      stderrDiagnosticLines.push(line);
    }
  }
}

function summarizeCodexDiagnostics(structuredErrors = [], stderrLines = []) {
  const lines = [];
  const seen = new Set();
  for (const value of [...structuredErrors.map((entry) => typeof entry === 'string' ? entry : entry?.text), ...stderrLines]) {
    for (const line of String(value ?? '').split(/\r?\n/).map((item) => item.trim()).filter(Boolean)) {
      const key = line.replace(/^\s*(?:error|warning|fatal)\s*[:\-]\s*/i, '').trim().toLowerCase();
      if (seen.has(key)) continue;
      seen.add(key);
      lines.push(line);
    }
  }
  return {
    lines,
    reconnect: lines.filter((line) => /reconnecting|stream disconnected|retry/i.test(line)).length,
    capacity: lines.filter((line) => /at capacity/i.test(line)).length,
  };
}

function readCodexProviderId() {
  try {
    const parsed = parseRouteToml(fs.readFileSync(path.join(CODEX_HOME, 'config.toml'), 'utf8'));
    return typeof parsed.model_provider === 'string' ? parsed.model_provider : 'openai';
  } catch { return 'openai'; }
}

function codexStreamIdleArgs() {
  const value = config.codexStreamIdleTimeoutMs;
  if (!Number.isSafeInteger(value) || value <= 0) return [];
  const provider = readCodexProviderId();
  if (['openai', 'ollama', 'lmstudio'].includes(provider)) {
    log(`codex stream idle timeout: provider ${provider} is built-in; not overridden`);
    return [];
  }
  // Codex 按点拆分 CLI 配置键；特殊 id 改用内联表，保留原 provider 的其他配置。
  return ['-c', /^[A-Za-z0-9_-]+$/.test(provider)
    ? `model_providers.${provider}.stream_idle_timeout_ms=${value}`
    : `model_providers={${JSON.stringify(provider)}={stream_idle_timeout_ms=${value}}}`];
}
beginRound();

// ---------- 只读核对：git 状态前后对比 + 执行期间新写入的文件（含 git 忽略的路径） ----------
const readOnlyCheck = !write && !monitor;
const relativeChild = (child, parent) => {
  const relative = path.relative(parent, child);
  return relative && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative) ? relative : null;
};
const automaticExcludes = [STATE_DIR, LOG_DIR].map((directory) => relativeChild(directory, cwd)).filter(Boolean);
const excludes = [...(config.readOnlyExclude ?? []), ...excludeArgs, ...automaticExcludes]
  .map((p) => p.replace(/^\.\/+/, '').replace(/\/+$/, '')).filter(Boolean);
const isExcluded = (rel) => excludes.some((e) => rel === e || rel.startsWith(`${e}/`));
if (readOnlyCheck && excludes.length) log(`read-only exclude: ${excludes.join(', ')}`);

function gitSnapshot() {
  const run = (args) => spawnSync('git', ['-C', cwd, ...args], { encoding: 'buffer', maxBuffer: 256 * 1024 * 1024 });
  const st = run(['status', '--porcelain', '--untracked-files=all']);
  if (st.status !== 0) return null;
  const diff = run(['diff', 'HEAD', '--binary']);
  const lines = st.stdout.toString('utf8').split('\n').filter(Boolean).filter((l) => !isExcluded(l.slice(3)));
  return { lines, diffHash: crypto.createHash('sha256').update(diff.stdout ?? '').digest('hex') };
}
const before = readOnlyCheck ? gitSnapshot() : null;

// 提交与进度使用独立快照，不受只读 exclude 影响；NUL 分隔保留空格、中文及重命名路径。
function repoGit(args) {
  return spawnSync('git', ['-C', cwd, '--literal-pathspecs', ...args],
    { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 });
}

function contentHash(root, name) {
  const file = path.join(root, name);
  try {
    const stat = fs.lstatSync(file);
    const content = stat.isSymbolicLink() ? fs.readlinkSync(file) : stat.isDirectory()
      ? spawnSync('git', ['-C', file, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).stdout ?? ''
      : fs.readFileSync(file);
    return crypto.createHash('sha256').update(`${stat.mode}:`).update(content).digest('hex');
  } catch (e) {
    if (e.code === 'ENOENT' || e.code === 'ENOTDIR') return null;
    throw e;
  }
}

function changeSnapshot() {
  const rootResult = repoGit(['rev-parse', '--show-toplevel']);
  if (rootResult.status !== 0) return null;
  const root = rootResult.stdout.trimEnd();
  const result = repoGit(['status', '--porcelain=v1', '-z', '--untracked-files=all']);
  if (result.status !== 0) throw new Error(result.error?.message ?? result.stderr.trim());
  const entries = result.stdout.split('\0').filter(Boolean);
  const files = new Map();
  for (let i = 0; i < entries.length; i++) {
    const entry = entries[i];
    const name = entry.slice(3);
    files.set(name, contentHash(root, name));
    if (/[RC]/.test(entry.slice(0, 2))) {
      const original = entries[++i];
      files.set(original, contentHash(root, original));
    }
  }
  return { root, files };
}

const changesBefore = progressPath !== null || commitMessage !== null ? changeSnapshot() : null;
let dispatchedPaths = null;
function changedPaths() {
  if (dispatchedPaths !== null) return dispatchedPaths;
  if (!changesBefore) return null;
  const after = changeSnapshot();
  const names = new Set([...changesBefore.files.keys(), ...(after?.files.keys() ?? [])]);
  return [...names].filter((name) => !changesBefore.files.has(name) ||
    contentHash(changesBefore.root, name) !== changesBefore.files.get(name)).sort();
}

function commitChanges() {
  if (!changesBefore) return 'cwd 不是 git 仓库';
  dispatchedPaths = changedPaths();
  const paths = dispatchedPaths.map((name) => path.relative(cwd, path.join(changesBefore.root, name)));
  // 已在 index 删除的路径不再交给 add；commit --only 仍会包含这些删除。
  const toAdd = paths.filter((name) => fs.existsSync(path.resolve(cwd, name)) ||
    repoGit(['ls-files', '--error-unmatch', '--', name]).status === 0);
  const commands = [...(toAdd.length ? [['add', '-A', '--', ...toAdd]] : []),
    ['commit', '--only', '-m', commitMessage, '--', ...paths], ['rev-parse', '--short', 'HEAD']];
  for (const args of commands) {
    const result = repoGit(args);
    log(`commit command: ${JSON.stringify(args)}\n${result.stdout ?? ''}${result.stderr ?? ''}`);
    if (result.error || result.status !== 0) {
      return (result.error?.message || result.stderr || result.stdout || `git exit ${result.status}`)
        .trim().split(/\r?\n/)[0];
    }
    if (args[0] === 'rev-parse') commitHash = result.stdout.trim();
  }
  return null;
}

function reportField(text, name) {
  const values = [];
  let active = false;
  for (const line of text.split('\n')) {
    const field = line.match(/^[ \t*>-]*(状态|结论|改动文件|验证|偏差|遗留问题)\**[ \t]*[:：][ \t]*(.*)$/);
    if (field) {
      active = field[1] === name;
      if (active && field[2].trim()) values.push(field[2].trim());
    } else if (active && /^[ \t]+\S/.test(line)) {
      values.push(line.trim().replace(/^[-*][ \t]+/, ''));
    } else if (active && line.trim()) active = false;
  }
  return values;
}

// exit 覆盖普通收尾和信号退出；返工中间轮不追加进度。
if (progressPath !== null) process.once('exit', (code) => {
  const record = progressRecord?.record ?? {
    tier, model, effort, status: 'error', elapsed: Math.round((Date.now() - startedAt) / 1000),
    tokens: numeric(codexTokens), log_id: path.basename(base), verify: verifyResult, commit: commitHash, resumed_from: resumeArg,
  };
  const text = progressRecord?.text ?? '';
  const oneLine = (value) => String(value).replace(/[\r\n]+/g, ' ');
  try {
    const parts = Object.fromEntries(new Intl.DateTimeFormat('sv-SE', {
      timeZone: 'Asia/Singapore', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    }).formatToParts(new Date()).map(({ type, value }) => [type, value]));
    const timestamp = `${parts.year}-${parts.month}-${parts.day} ${parts.hour}:${parts.minute}`;
    const paths = changedPaths();
    const files = paths === null ? reportField(text, '改动文件').flatMap((value) => value.split(/[,，;；、]/))
      .map((value) => value.trim().replace(/^`|`$/g, '')).filter((value) => value && value !== '无')
      .map((name) => path.isAbsolute(name) ? path.relative(cwd, name) : name)
      : paths.map((name) => path.relative(cwd, path.join(changesBefore.root, name)));
    const line = `- ${label === null ? '' : `${oneLine(label)} `}${timestamp} [${record.log_id}] ${tier} ${record.model} ${record.effort}` +
      ` | ${record.status} | ${record.elapsed}s | ${record.tokens === null ? '?' : Math.round(record.tokens / 1000)}k tok` +
      ` | verify ${record.verify?.status ?? '-'}${record.commit ? ` | commit ${record.commit}` : ''}` +
      `${record.resumed_from ? ` | resumed ${record.resumed_from}` : ''} | 改动: ${files.slice(0, 8).map(oneLine).join(', ') || '无'}`;
    const lines = [line];
    for (const field of ['偏差', '遗留问题']) {
      const values = reportField(text, field).filter((value) => value !== '无');
      if (values.length) lines.push(`  - ${field}: ${values.map(oneLine).join('; ')}`);
    }
    const contents = fs.readFileSync(progressPath, 'utf8');
    fs.appendFileSync(progressPath, `${contents && !contents.endsWith('\n') ? '\n' : ''}${lines.join('\n')}\n`);
  } catch (e) {
    process.stderr.write(`agent-route: progress FAIL: ${e.message}\n`);
    if (code === 0) process.exitCode = 2;
  }
});
// find -newer 以标记文件的 mtime 为界
const markerPath = `${base}.marker`;
if (readOnlyCheck) fs.writeFileSync(markerPath, '');

function newerFiles() {
  // 解释器运行时自动生成的字节码缓存不算越权写入
  const args = [cwd, '-newer', markerPath, '-type', 'f', '-not', '-path', '*/.git/*', '-not', '-path', '*/__pycache__/*'];
  for (const e of excludes) args.push('-not', '-path', `${path.join(cwd, e)}/*`);
  const r = spawnSync('find', args, { encoding: 'utf8', maxBuffer: 256 * 1024 * 1024 });
  return (r.stdout ?? '').split('\n').filter(Boolean).map((p) => path.relative(cwd, p));
}

function readOnlyWarning() {
  if (!readOnlyCheck) return null;
  const problems = [];
  const after = before ? gitSnapshot() : null;
  if (after) {
    const was = new Set(before.lines);
    const now = new Set(after.lines);
    const changed = [...after.lines.filter((l) => !was.has(l)).map((l) => `+${l}`),
      ...before.lines.filter((l) => !now.has(l)).map((l) => `-${l}`)];
    if (changed.length || after.diffHash !== before.diffHash) {
      problems.push(`git 状态 ${changed.length ? changed.join('; ') : '已改动文件的内容有变化'}`);
    }
  }
  const files = newerFiles();
  try { fs.unlinkSync(markerPath); } catch {}
  if (files.length) problems.push(`新写入 ${files.length} 个文件 ${files.slice(0, 10).join('; ')}${files.length > 10 ? ' …' : ''}`);
  if (!problems.length) return null;
  log(`read-only check: ${problems.join(' | ')}`);
  if (files.length > 10) log(`read-only newer files:\n${files.join('\n')}`);
  return `WARNING: 只读模式下 ${cwd} 有变化（也可能来自并发写入）: ${problems.join(' | ')}`;
}

// ---------- 摘要日志：成功的派发只保留头部、命令列表、tokens 和汇报 ----------
function compactLog(text) {
  let full;
  try { full = fs.readFileSync(logPath, 'utf8'); } catch { return; }
  const lines = full.split('\n');
  const header = lines.filter((l) => /^(tier|cwd|write|model|effort|prompt-file|time|monitor|prompt_chars|providers|provider-change|provider-change action|resumed|attempt|attempt start|attempt failure|rebuild failure|failure class|source|session id|exec|fallback|read-only exclude|verify command|verify exit|verify result|codex stream idle timeout|claude [a-zA-Z_]+|exit|stdout bytes|finish): /.test(l));
  const commands = [];
  for (let i = 0; i < lines.length; i++) {
    if (lines[i] !== 'exec') continue;
    let j = i + 1;
    while (j < lines.length && !/^ (succeeded|exited -?\d+) in /.test(lines[j])) j++;
    const body = lines.slice(i + 1, j);
    const first = (body[0] ?? '').slice(0, 300);
    const extra = body.length > 1 ? ` …(+${body.length - 1} 行)` : '';
    commands.push(`- ${first}${extra} →${(lines[j] ?? ' (无结果)').replace(/:$/, '')}`);
    i = j;
  }
  const out = [...header, `log-mode: summary（完整过程日志已删除）`,
    ...reconnectLines.map((line) => `codex stream: ${line}`), `commands: ${commands.length}`, ...commands,
    '--- 最终汇报 ---', text.replace(/\s+$/, '')];
  try { fs.writeFileSync(logPath, out.join('\n') + '\n'); } catch {}
}

// ---------- 汇报状态与 footer ----------
function parseStatus(text) {
  const m = text.match(/^[\s*>-]*状态\**\s*[:：]\s*\**\s*(\S+)/m);
  if (!m) return 'unknown';
  const v = m[1].replace(/[*`，,。.；;]+$/, '');
  if (v.startsWith('部分完成')) return 'partial';
  if (v.startsWith('未完成')) return 'failed';
  if (v.startsWith('完成')) return 'complete';
  return 'unknown';
}

// 仅压缩 stdout；日志、prompt 和 history 中的路径保留原文。
function compactPaths(text) {
  const roots = new Map([[cwd, '.']]);
  if (cwdArg !== null) roots.set(path.resolve(cwdArg), '.');
  roots.set(LOG_DIR, '<logs>/');
  const escape = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const ordered = [...roots].sort(([a], [b]) => b.length - a.length);
  const alternatives = ordered.map(([root]) => root === path.parse(root).root ? escape(root) :
    `${escape(root)}(?:/|(?=$|[\\s"'\x60<>()[\\]{}:;,，。；：]))`);
  return text.replace(new RegExp(alternatives.join('|'), 'g'), (match, offset) => {
    const [, label] = ordered.find(([root]) => match === root || match === `${root}/`);
    if (label !== '.') return label;
    const next = text[offset + match.length];
    return match.endsWith('/') && next && !/[\s"'`<>()[\]{}:;,，。；：]/.test(next) ? '' : '.';
  });
}

function reportConclusion(text) {
  if (!reportField(text, '结论').some((value) => value.replace(/^[-*]\s*/, '').trim())) return '';
  return text.match(/^[ \t*>-]*结论\**[ \t]*[:：][\s\S]*?(?=^[ \t*>-]*(?:状态|结论|改动文件|验证|偏差|遗留问题)\**[ \t]*[:：]|(?![\s\S]))/m)?.[0] ?? '';
}

function compactReport(text) {
  const conclusion = readOnlyCheck ? reportConclusion(text) : '';
  if (readOnlyCheck && !conclusion) return null;
  for (const field of ['偏差', '遗留问题']) {
    const values = reportField(text, field);
    const present = new RegExp(`^[ \\t*>-]*${field}\\**[ \\t]*[:：]`, 'm').test(text);
    if (values.some((value) => value !== '无') || (!values.length && present)) return null;
  }
  const oneLine = (value, limit) => Array.from(compactPaths(value).replace(/\s+/g, ' ').trim()).slice(0, limit).join('');
  return `完成 | 改动: ${oneLine(reportField(text, '改动文件').join('; '), 200)} | 验证: ${oneLine(reportField(text, '验证')[0] ?? '', 120)}\n` +
    conclusion + (conclusion && !conclusion.endsWith('\n') ? '\n' : '');
}

// 每条验证命令独立限时，完整输出写日志，只把失败输出的末尾交给主 agent。
function runVerify(command) {
  return new Promise((resolve) => {
    const lines = [];
    let pending = '';
    const collect = (chunk) => {
      const text = String(chunk);
      fs.appendFileSync(logPath, text);
      const parts = text.split('\n');
      for (let i = 0; i < parts.length; i++) {
        pending = Array.from(pending + parts[i]).slice(0, 200).join('');
        if (i < parts.length - 1) {
          lines.push(pending.replace(/\r$/, ''));
          if (lines.length > 15) lines.shift();
          pending = '';
        }
      }
    };
    log(`verify command: ${command}`);
    const child = spawn('/bin/zsh', ['-lc', command], { cwd, stdio: ['ignore', 'pipe', 'pipe'], detached: true });
    let timedOut = false;
    const killGroup = (signal) => { try { process.kill(-child.pid, signal); } catch { try { child.kill(signal); } catch {} } };
    const timer = setTimeout(() => {
      timedOut = true;
      killGroup('SIGTERM');
      setTimeout(() => killGroup('SIGKILL'), 5000).unref();
    }, 10 * 60_000);
    const onSignal = () => { killGroup('SIGTERM'); process.exit(130); };
    for (const signal of ['SIGINT', 'SIGTERM']) process.on(signal, onSignal);
    child.stdout.setEncoding('utf8');
    child.stderr.setEncoding('utf8');
    child.stdout.on('data', collect);
    child.stderr.on('data', collect);
    let spawnError = null;
    child.on('error', (error) => { spawnError = error; collect(`${error.message}\n`); });
    child.on('close', (code, signal) => {
      clearTimeout(timer);
      for (const signal of ['SIGINT', 'SIGTERM']) process.removeListener(signal, onSignal);
      if (pending) { lines.push(pending); if (lines.length > 15) lines.shift(); }
      const exitCode = timedOut ? 124 : spawnError ? 127 : code ?? 128 + (os.constants.signals[signal] ?? 0);
      log(`\nverify exit: ${exitCode}${timedOut ? ' (timeout)' : ''}`);
      resolve({ command, exit_code: exitCode, output: exitCode === 0 ? [] : lines });
    });
  });
}

function verifySummary(result) {
  if (result.status === 'PASS') return 'verify: PASS';
  return result.results.filter((entry) => entry.exit_code !== 0).map((entry) =>
    [`verify: FAIL ${entry.command} → exit ${entry.exit_code}`, ...entry.output].join('\n')).join('\n');
}

function recordFinish(status, code, output, tokens, actualModel = model, actualEffort = effort, elapsed = Math.round((Date.now() - startedAt) / 1000)) {
  const record = {
    time: new Date(startedAt).toISOString(), tier, model: actualModel, effort: actualEffort,
    monitor, write, fallback: usedFallback, status, exit_code: code, elapsed, tokens: numeric(tokens), session,
    reconnect: reconnectCount, capacity: capacityCount, stall: codexStall.count, stall_seconds: codexStall.seconds,
    log_id: path.basename(base), cwd, prompt_chars: charCount(promptText), stdout_chars: charCount(output), resumed_from: resumeArg,
    verify: verifyResult,
    commit: commitHash,
    executor,
    attempt: attemptPhase,
    ...(providerChange ? { provider_change: providerChange } : {}),
    ...(dispatchContext.enabled ? { providers: { codex: safeRouteContext(dispatchContext.codex), claude: safeRouteContext(dispatchContext.claude) } } : {}),
  };
  if (verifyResult) log(`verify result: ${JSON.stringify(verifyResult)}`);
  log(`finish: status=${status} tokens=${tokens ?? '?'} elapsed=${elapsed} session=${session ?? '?'} exit_code=${code} stdout_chars=${record.stdout_chars} model=${actualModel} effort=${actualEffort ?? '?'} fallback=${usedFallback} executor=${executor} reconnect=${reconnectCount} capacity=${capacityCount} stall=${codexStall.count} stall_seconds=${codexStall.seconds}${commitHash ? ` commit=${commitHash}` : ''}`);
  appendHistory(record);
  progressRecord = { record, text: output };
}

async function finishReport(text, tokens, actualModel = model, actualEffort = effort, executor = 'codex') {
  const status = monitor ? null : parseStatus(text);
  // 必须先拍只读核对的“之后”快照；verify 产生的写入属于已授权验证。
  let warning = readOnlyWarning();
  if (readOnlyCheck && !reportConclusion(text)) {
    warning = [warning, 'WARNING: 只读汇报缺少结论'].filter(Boolean).join('\n');
  }
  if (verifyCommands.length && parseStatus(text) === 'complete') {
    const results = [];
    for (const command of verifyCommands) results.push(await runVerify(command));
    verifyResult = { status: results.every((entry) => entry.exit_code === 0) ? 'PASS' : 'FAIL', results };
  }
  const elapsed = Math.round((Date.now() - startedAt) / 1000);
  const count = numeric(tokens);
  const parts = [`route: ${tier} ${actualModel} ${actualEffort}`, `${elapsed}s`,
    `${count === null ? '?' : `${Math.round(count / 1000)}k`} tok`, status ?? 'n/a', `id ${path.basename(base)}`];
  if (reconnectCount || capacityCount) parts.push(`reconnect ${reconnectCount}`, `capacity ${capacityCount}`);
  if (codexStall.count) parts.push(`stall ${codexStall.count}/${codexStall.seconds}s`);
  if (codexLimitReason && executor === 'claude') parts[0] += `（${codexLimitReason}）`;
  try { if (fs.statSync(reportPath).size > 0) parts.push('report'); } catch {}
  if (resumeArg !== null) parts.push(`resumed ${resumeArg}`);
  if (providerChange) parts.push(`provider changed (${providerChange.app}); ${providerChange.action}`);
  if (fixRound) parts.push(`fixed-after ${fixRound}`);
  if (recoveryFlow && attemptPhase !== null) parts.push(`step ${attemptPhase}`);
  const failed = verifyResult?.status === 'FAIL';
  const retry = failed && write && fixRound < fixRounds && SESSION_ID.test(session ?? '');
  if (failed && write && fixRound < fixRounds && !SESSION_ID.test(session ?? '')) {
    warning = [warning, 'WARNING: verify 失败但找不到 session，无法自动返工'].filter(Boolean).join('\n');
  }
  const commitFailure = commitMessage !== null && !retry && status === 'complete' &&
    (!verifyCommands.length || verifyResult?.status === 'PASS') && !warning && !/\bWARNING\b/.test(text)
    ? commitChanges() : null;
  if (commitHash) parts.push(`commit ${commitHash}`);
  const lines = ['', '---', parts.join(' | ')];
  if (warning) lines.push(warning);
  if (commitFailure) lines.push(`commit FAIL: ${commitFailure}`);
  const code = commitFailure ? 14 : failed ? 13 : status && status !== 'complete' ? 11 : 0;
  const verification = verifyResult ? verifySummary(verifyResult) + '\n' : '';
  const report = (text.endsWith('\n') ? text : text + '\n') + verification;
  const rawOutput = report + lines.join('\n') + '\n';
  log(`--- 最终输出 ---\n${rawOutput}`);
  const summary = !fullOutput && !monitor && status === 'complete' &&
    (!verifyCommands.length || verifyResult?.status === 'PASS') && !warning && !/\bWARNING\b/.test(text)
    ? compactReport(text) : null;
  const output = retry ? '' : compactPaths(summary === null ? rawOutput : summary + verification + lines.join('\n') + '\n');
  recordFinish(status ?? 'n/a', code, output, tokens, actualModel, actualEffort, elapsed);
  if (summary !== null) progressRecord.text = compactPaths(text);
  if (config.logMode === 'summary' && code === 0 && !warning) compactLog(report);
  if (retry) {
    const previous = path.basename(base);
    promptText = `自动返工：上轮 verify 失败。请修复以下验证失败的问题，完成后重新按规定格式汇报。\n\n<verify_failure>\n${verifySummary(verifyResult).replace(/\s+$/, '')}\n</verify_failure>\n`;
    resumeArg = previous;
    fixRound++;
    attemptSerial = 0;
    attemptPhase = null;
    recoveryFlow = false;
    resumeRetryCount = 0;
    freshAttemptCount = 0;
    beginRound();
    if (executor === 'claude') return runClaude('verify 失败后自动返工', true);
    codexResume = true;
    return runCodex();
  }
  process.stdout.write(output, () => process.exit(code));
}

function fallback(reason) {
  usedFallback = true;
  log(`fallback: ${reason}`);
  const oneLine = String(reason).replace(/\s+/g, ' ').trim();
  if (!noClaude) return runClaude(oneLine);
  const output = `FALLBACK
tier: ${tier}
reason: ${oneLine}
write: ${write}
cwd: ${cwd}
prompt-file: ${fullPromptPath}
log: ${logPath}
${recoveryFlow && attemptPhase ? `attempt: ${attemptPhase}\n` : ''}`;
  recordFinish('fallback', 10, output, codexTokens);
  process.stdout.write(output, () => process.exit(10));
}

function failResume(reason) {
  const oneLine = String(reason).replace(/\s+/g, ' ').trim();
  log(`resume failure: ${oneLine}`);
  const output = `ERROR\ntier: ${tier}\nreason: ${oneLine}\nwrite: ${write}\ncwd: ${cwd}\nprompt-file: ${fullPromptPath}\nlog: ${logPath}\nresumed: ${resumeArg}\n`;
  recordFinish('error', 12, output, codexTokens);
  process.stdout.write(output, () => process.exit(12));
}

function recordCodexFailure(reason) {
  const oneLine = String(reason).replace(/\s+/g, ' ').trim();
  log(`attempt failure: ${attemptPhase ?? 'resume'}: ${oneLine}`);
  recordFinish('error', 12, '', codexTokens);
}

function stopUnknownRoute(app) {
  executor = app;
  const reason = dispatchContext[app].diagnostics.join(', ') || 'billing-unverified';
  const output = `ERROR\ntier: ${tier}\nreason: ${app} 服务商或计费类型无法确认 (${reason})\nlog: ${logPath}\n`;
  recordFinish('error', 12, output, null);
  process.stdout.write(output, () => process.exit(12));
}

function writeModelCooldown() {
  const data = readCooldown();
  data[routeStateKey('codex', dispatchContext.codex, model)] = new Date(Date.now() + cooldownMs).toISOString();
  writeCooldown(data);
}

function limitStop(state, claudeLimit = null, actualModel = model, actualEffort = effort) {
  const resets = state?.resets_at ? new Date(state.resets_at * 1000) : null;
  const codexReset = resets ? fmtLocal(resets) : '恢复时间未知';
  const claudeReset = claudeLimit?.resets_at ? fmtLocal(new Date(claudeLimit.resets_at * 1000)) : '恢复时间未知';
  log(`limit: codex ${resets?.toISOString() ?? 'unknown'}${claudeLimit ? ` claude ${claudeReset}` : ''}`);
  const codexLabel = dispatchContext.codex?.billingType === 'api'
    ? `Codex API 服务商限额 (${safeProviderLabel(dispatchContext.codex.providerName) ?? 'unknown'}, ${state?.type ?? 'unknown'})` : 'Codex 用量限额';
  const reason = claudeLimit ? `${codexLabel}，${codexReset}；Claude 用量限额，${claudeReset}` : `${codexLabel}，${codexReset} 恢复；已指定 --no-claude`;
  const output = `LIMIT\ntier: ${tier}\nreason: ${reason}\nresets: ${resets?.toISOString() ?? 'unknown'}\n${claudeLimit ? `claude-resets: ${claudeLimit.resets_at ? new Date(claudeLimit.resets_at * 1000).toISOString() : 'unknown'}\n` : ''}write: ${write}\ncwd: ${cwd}\nprompt-file: ${fullPromptPath}\nlog: ${logPath}\n${resumeArg !== null ? `resumed: ${resumeArg}\n` : ''}`;
  recordFinish('limit', 15, output, codexTokens, actualModel, actualEffort);
  process.stdout.write(output, () => process.exit(15));
}

const PARTIAL_WORK_REMINDER = '工作区可能已有上一个执行方的部分改动，先查看 git diff。';

// 沿 resumed_from 链读取各次派发保存的 <task>，拼成"原任务 + 新增要求"；找不到原任务时返回 null。
function rebuildTask() {
  if (resumeArg === null) return promptText;
  const tasks = [];
  let source = SESSION_ID.test(resumeArg) ? readHistory().findLast((record) => record.session === resumeArg)?.log_id : resumeArg;
  const seen = new Set();
  while (source && !SESSION_ID.test(source) && !seen.has(source)) {
    seen.add(source);
    try {
      const original = fs.readFileSync(path.join(LOG_DIR, `${path.basename(source)}.prompt.md`), 'utf8');
      const task = original.match(/<task>\n([\s\S]*?)\n<\/task>\n\n<output_contract>/)?.[1];
      if (task?.startsWith(PARTIAL_WORK_REMINDER)) {
        // 重建过的说明已经包含更早的任务，不再沿链向上，避免重复。
        tasks.unshift(task.slice(PARTIAL_WORK_REMINDER.length).replace(/^\s+/, ''));
        break;
      }
      if (task) tasks.unshift(task);
    } catch { /* 优先读取派发时保存的任务，不读取会话对话内容 */ }
    source = findResume(source)?.resumed_from;
  }
  if (!tasks.length) return null;
  return `${tasks.join('\n\n')}\n\n新增要求：\n${promptText}`;
}

// takeOverCodex 与续跑失败后的新线程共用：把重建后的说明写入当前 prompt 和 prompt 文件。
function rebuildPromptFromResume() {
  const taskText = rebuildTask();
  if (taskText === null) return false;
  fullPrompt = fullPrompt.replace(/(<task>\n)[\s\S]*?(\n<\/task>\n\n<output_contract>)/,
    (_match, start, end) => `${start}${PARTIAL_WORK_REMINDER}\n\n${taskText.replace(/\s+$/, '')}${end}`);
  fs.writeFileSync(fullPromptPath, `工作目录: ${cwd}（所有命令都在这个目录下执行）\n${fullPrompt}`);
  return true;
}

function takeOverCodex(state) {
  if (noClaude) return limitStop(state);
  usedFallback = true;
  codexLimitReason = `codex ${dispatchContext.codex?.billingType === 'api' ? 'API 服务商 ' : ''}${state.type} 限额${state.resets_at ? `至 ${fmtLocal(new Date(state.resets_at * 1000))}` : '，恢复时间未知'}`;
  if (!rebuildPromptFromResume()) {
    return failResume('Codex 限额，找不到原任务说明；请用日志 id 续跑并保留 prompt 文件');
  }
  if (recoveryFlow) attemptPhase = 'claude fallback';
  session = null;
  codexResume = false;
  return runClaude(codexLimitReason);
}

// Claude Code #79500：限额可在 exit 0 的 is_error=true/result 中返回；也兼容 exit 1。
function detectClaudeLimit(data, text, code) {
  const result = typeof data?.result === 'string' ? data.result : text;
  const failed = data?.is_error === true || code !== 0 || data?.api_error_status === 429;
  if (!failed || !/you[’']ve hit your (?:[\w -]+ )?limit|rate.?limit (?:reached|exceeded)|usage limit|out of usage credits/i.test(result)) return null;
  const epoch = data?.rate_limit_info?.resetsAt;
  if (typeof epoch === 'number' && Number.isFinite(epoch)) return { resets_at: epoch };
  const hint = result.match(/resets?\s+(.+?)(?:\s*\(([^)]+)\))?\s*$/i);
  if (!hint) return { resets_at: null };
  const clock = hint[1].match(/^(\d{1,2})(?::(\d{2}))?\s*(am|pm)$/i);
  if (clock) {
    const hour = Number(clock[1]) % 12 + (/pm/i.test(clock[3]) ? 12 : 0);
    const minute = Number(clock[2] ?? 0);
    // 按报错中的时区寻找下一个对应分钟，兼容夏令时与跨日。
    try {
      const format = new Intl.DateTimeFormat('en-GB', { timeZone: hint[2] ?? Intl.DateTimeFormat().resolvedOptions().timeZone,
        hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
      const start = Math.floor(Date.now() / 60_000) * 60_000;
      for (let offset = 1; offset <= 26 * 60; offset++) {
        const at = start + offset * 60_000;
        if (format.format(at) === `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`) return { resets_at: at / 1000 };
      }
    } catch {}
  }
  const parsed = Date.parse(hint[1]);
  return { resets_at: Number.isFinite(parsed) && parsed > Date.now() ? parsed / 1000 : null };
}

function startAttempt(phase) {
  attemptPhase = phase;
  attemptSerial++;
  beginRound();
  log(`attempt start: ${phase}`);
}

// 续跑时 Codex 失败：同 session 重试 1 次 → 新 Codex 线程最多 2 次 → 写冷却并交给 Claude（--no-claude 输出 FALLBACK）。
function failCodex(reason, failureContext = {}) {
  const oneLine = String(reason).replace(/\s+/g, ' ').trim();
  if (!failureContext.classified) {
    logCodexFailure(failureContext.tail ?? reason, failureContext.code ?? 1, failureContext.telemetry ?? {});
  }
  if (resumeArg === null) {
    writeModelCooldown();
    return fallback(reason);
  }
  recoveryFlow = true;
  attemptPhase ??= 'resume';
  recordCodexFailure(oneLine);
  if (codexResume && resumeRetryCount === 0) {
    resumeRetryCount++;
    startAttempt('resume retry');
    return runCodex();
  }
  const rebuilt = freshAttemptCount < 2 ? rebuildTask() : null;
  if (freshAttemptCount < 2 && rebuilt === null) log('rebuild failure: 找不到原任务说明；跳过新线程');
  if (rebuilt !== null) {
    freshAttemptCount++;
    session = null;
    codexResume = false;
    startAttempt(`fresh attempt ${freshAttemptCount}`);
    rebuildPromptFromResume();
    return runCodex();
  }
  writeModelCooldown();
  session = null;
  codexResume = false;
  startAttempt('claude fallback');
  if (!rebuildPromptFromResume() && !noClaude) {
    return failResume('Codex 续跑和新线程均失败，找不到原任务说明，无法交给 Claude；请用日志 id 续跑并保留 prompt 文件');
  }
  return fallback(oneLine);
}

function runClaude(codexReason, resume = false, spawnRetried = false) {
  executor = 'claude';
  if (dispatchContext.enabled && dispatchContext.claude.billingType === 'unknown') return stopUnknownRoute('claude');
  const { model: claudeModel, effort: claudeEffort } = resolveClaudeModel(tier, dispatchContext.claude, config, { write, monitor });
  const claudeBin = config.claudeBin ?? 'claude';
  const args = ['-p', `执行 ${fullPromptPath}`, '--agents', path.join(ROOT, 'agents.json'), '--agent', tier,
    '--model', claudeModel, '--effort', claudeEffort, '--output-format', 'json',
    '--permission-mode', config.claudePermissionMode ?? 'auto',
    // 只拦截 agent-route skill，不影响其他 skill；与 AGENT_ROUTE_DEPTH 共同防止递归派发。
    '--settings', JSON.stringify({ permissions: { deny: ['Skill(agent-route)'] } })];
  if (resume) args.push('--resume', session);
  if (!write) args.push('--disallowedTools', 'Edit', 'Write', 'NotebookEdit');
  // 仅传入运行命令需要的环境，隔离主会话和路由控制变量。
  const env = { ...claudeEnvironment(dispatchContext.claude), AGENT_ROUTE_DEPTH: '1' };

  const failClaude = (reason) => {
    const oneLine = String(reason).replace(/\s+/g, ' ').trim();
    log(`claude failure: ${oneLine}`);
    const output = `ERROR
tier: ${tier}
codex: ${codexReason}
claude: ${oneLine}
cwd: ${cwd}
prompt-file: ${fullPromptPath}
log: ${logPath}
`;
    recordFinish('error', 12, output, codexTokens, claudeModel, claudeEffort);
    process.stdout.write(output, () => process.exit(12));
  };

  if (!refreshProgramConfig(config, 'claude', false)) return failClaude(missingProgram('claude'));

  const quota = claudeQuota(config, dispatchContext.claude, true);
  if (quota.snapshot) log(`claude weekly: ${JSON.stringify(quota.snapshot)}`);
  if (quota.limit) {
    const state = readCodexQuota(dispatchContext.codex, model);
    if (limitActive(state)) return limitStop(state, quota.limit, claudeModel, claudeEffort);
    return failClaude(`Claude 周用量 ${quota.limit.used_percent}% ≥ ${config.claudeWeeklyThreshold ?? 80}%，冷却至 ${fmtLocal(new Date(quota.limit.resets_at * 1000))}`);
  }
  log(`exec: ${[claudeBin, ...args].map((a) => JSON.stringify(a)).join(' ')}`);

  let child;
  try {
    child = spawn(claudeBin, args, { cwd, env, stdio: ['ignore', 'pipe', 'pipe'], detached: true });
  } catch (e) { return failClaude(`spawn 失败: ${e.message}`); }
  let stdout = '';
  let stderr = '';
  let timedOut = false;
  let finished = false;
  child.stdout.setEncoding('utf8');
  child.stdout.on('data', (c) => { stdout += c; });
  child.stderr.on('data', (c) => { stderr = (stderr + c.toString()).slice(-4096); try { fs.appendFileSync(logPath, c); } catch {} });
  const killGroup = (sig) => { try { process.kill(-child.pid, sig); } catch { try { child.kill(sig); } catch {} } };
  const timer = setTimeout(() => {
    timedOut = true;
    killGroup('SIGTERM');
    setTimeout(() => killGroup('SIGKILL'), 5000).unref();
  }, (config.claudeTimeoutMinutes ?? 60) * 60_000);
  const onSignal = () => { killGroup('SIGTERM'); process.exit(130); };
  for (const s of ['SIGINT', 'SIGTERM']) process.on(s, onSignal);
  const finish = () => {
    if (finished) return false;
    finished = true;
    clearTimeout(timer);
    for (const s of ['SIGINT', 'SIGTERM']) process.removeListener(s, onSignal);
    return true;
  };
  child.on('error', (e) => {
    if (finish()) {
      if (!spawnRetried && ['ENOENT', 'EACCES'].includes(e.code) && refreshProgramConfig(config, 'claude', true)) {
        return runClaude(codexReason, resume, true);
      }
      failClaude(`spawn 失败: ${e.message}`);
    }
  });
  child.on('close', (code, signal) => {
    if (!finish()) return;
    log(`claude exit: code=${code} signal=${signal ?? 'none'} timedOut=${timedOut}`);
    if (timedOut) return failClaude(`超时（>${config.claudeTimeoutMinutes ?? 60} 分钟）`);
    let data;
    try { data = JSON.parse(stdout); } catch { /* 非 JSON 失败信息仍参与限额识别 */ }
    const claudeLimit = detectClaudeLimit(data, `${stdout}\n${stderr}`, code);
    if (claudeLimit) {
      const state = readCodexQuota(dispatchContext.codex, model);
      if (limitActive(state)) return limitStop(state, claudeLimit, claudeModel, claudeEffort);
      return failClaude(`Claude 用量限额，${claudeLimit.resets_at ? fmtLocal(new Date(claudeLimit.resets_at * 1000)) : '恢复时间未知'}`);
    }
    if (code !== 0) return failClaude(`claude 退出码 ${code ?? 'signal ' + signal}${data?.result ? `: ${String(data.result).replace(/\s+/g, ' ').slice(0, 200)}` : ''}`);
    if (!data) return failClaude('JSON 解析失败');
    if (data?.is_error === true) return failClaude(`is_error=true: ${String(data.result ?? '').slice(0, 200)}`);
    if (data?.is_error !== false) return failClaude('is_error 不是 false');
    if (typeof data.result !== 'string' || !data.result.trim()) return failClaude('result 为空或不是字符串');
    const models = Object.keys(data.modelUsage ?? {}).join(',');
    session = SESSION_ID.test(data.session_id ?? '') ? data.session_id : resume ? session : null;
    log(`claude modelUsage: ${models}\nclaude total_cost_usd: ${data.total_cost_usd}`);
    const usage = Object.entries(data.usage ?? {}).filter(([k, v]) => k.endsWith('_tokens') && typeof v === 'number');
    const tokens = usage.length ? usage.reduce((s, [, v]) => s + v, 0).toLocaleString('en-US') : null;
    finishReport(data.result, tokens, models || claudeModel, claudeEffort, 'claude');
  });
}

// 模型失败冷却与账号限额分别决策；原 Claude 会话始终使用 Claude 续跑。
const until = resumeArg === null ? activeUntil(readCooldown(), routeStateKey('codex', dispatchContext.codex, model)) : null;
if (providerChange && !resumeError && dispatchContext[executor].billingType !== 'unknown') {
  if (!rebuildPromptFromResume()) {
    providerChange.action = 'stop';
    log('provider-change action: stopped because original task is unavailable');
    resumeError = '服务商变化或原服务商无法确认，且找不到原任务说明；已停止续跑';
  } else {
    session = null;
    codexResume = false;
    providerResumeRebuilt = true;
    log('provider-change action: rebuilt original task in a new session');
  }
}
if (resumeError) failResume(resumeError);
else if (dispatchContext.enabled && !forceClaude && executor !== 'claude' && dispatchContext.codex.billingType === 'unknown') stopUnknownRoute('codex');
else if (forceClaude) runClaude('主 agent 指定 --claude，未调用 Codex');
else if (resumeArg !== null && executor === 'claude') runClaude('跟随原 Claude 执行方续跑', !providerResumeRebuilt);
else {
  const state = dispatchContext.codex?.billingType === 'api' || noClaude
    ? readCodexQuota(dispatchContext.codex, model) : await checkCodexLimit(config);
  if (limitActive(state)) takeOverCodex(state);
  else {
    if (state?.type) clearCodexQuota(dispatchContext.codex, model, state);
    if (until) fallback(`cooldown until ${until.toISOString()} (${model})`);
    else runCodex();
  }
}

// Codex：codex exec 以本机环境运行（不用沙箱），只读靠 prompt 约束
function runCodex(spawnRetried = false) {
  executor = 'codex';
  if (dispatchContext.enabled && dispatchContext.codex.billingType === 'unknown') return stopUnknownRoute('codex');
  if (process.env.AGENT_ROUTE_FORCE_CODEX_FAIL === '1') return failCodex('forced failure (AGENT_ROUTE_FORCE_CODEX_FAIL=1)');
  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'agent-route-'));
  const lastMessage = path.join(tmpDir, 'last-message.md');
  const cleanup = () => { try { fs.rmSync(tmpDir, { recursive: true, force: true }); } catch {} };

  if (!refreshProgramConfig(config, 'codex', false)) return failCodex(missingProgram('codex'));
  const codexBin = config.codexBin ?? 'codex';
  const args = ['exec', ...(codexResume ? ['resume', session, '-'] : []),
    '--dangerously-bypass-approvals-and-sandbox', '--skip-git-repo-check',
    '-m', model, '-c', `model_reasoning_effort="${effort}"`,
    // 只对派发生效：没有 AGENTS.md 的目录读取 CLAUDE.md，不改 ~/.codex/config.toml
    '-c', 'project_doc_fallback_filenames=["CLAUDE.md"]',
    ...codexStreamIdleArgs(),
    ...(codexResume ? [] : ['-C', cwd]), '-o', lastMessage, ...(codexResume ? [] : ['-'])];
  log(`exec: ${codexBin} ${args.join(' ')}`);

  let child;
  const codexStartedAt = Date.now();
  try {
    child = spawn(codexBin, args, { cwd, env: { ...process.env, CODEX_HOME, AGENT_ROUTE_DEPTH: '1' }, stdio: ['pipe', 'pipe', 'pipe'], detached: true });
  } catch (e) { cleanup(); return failCodex(`spawn 失败: ${e.message}`); }
  child.stdin.on('error', () => {});
  child.stdin.end(fullPrompt);
  let stdout = '';
  let tail = '';
  let sessionTail = '';
  let timedOut = false;
  let finished = false;
  // codex exec 的 stdout/stderr 是过程输出，只进日志；汇报取 -o 文件，token 数取输出末尾的 "tokens used"
  const onOutput = (c) => {
    try { fs.appendFileSync(logPath, c); } catch {}
    tail = (tail + c.toString('utf8')).slice(-4096);
    if (!session) {
      const buffered = sessionTail + c.toString('utf8');
      session = buffered.match(/(?:^|\n)session id: ([0-9a-f-]{36})/i)?.[1] ?? null;
      sessionTail = buffered.slice(-512);
    }
  };
  const outputLines = [[child.stdout, false], [child.stderr, true]].map(([stream, isStderr]) => {
    stream.setEncoding('utf8');
    stream.on('data', onOutput);
    const lines = createInterface({ input: stream, crlfDelay: Infinity });
    if (isStderr) lines.on('line', observeCodexOutput);
    return lines;
  });
  const killGroup = (sig) => { try { process.kill(-child.pid, sig); } catch { try { child.kill(sig); } catch {} } };
  const timer = setTimeout(() => {
    timedOut = true;
    killGroup('SIGTERM');
    setTimeout(() => killGroup('SIGKILL'), 5000).unref();
  }, timeoutMs);
  const onSignal = () => { killGroup('SIGTERM'); cleanup(); process.exit(130); };
  for (const s of ['SIGINT', 'SIGTERM']) process.on(s, onSignal);
  const finish = () => {
    if (finished) return false;
    finished = true;
    clearTimeout(timer);
    for (const lines of outputLines) lines.close();
    try { stdout = fs.readFileSync(lastMessage, 'utf8'); } catch {}
    cleanup();
    for (const s of ['SIGINT', 'SIGTERM']) process.removeListener(s, onSignal);
    return true;
  };

  child.on('error', (e) => {
    if (finish()) {
      const reason = `spawn 失败: ${e.message}`;
      if (!spawnRetried && ['ENOENT', 'EACCES'].includes(e.code) && refreshProgramConfig(config, 'codex', true)) {
        logCodexFailure(reason, 1, { billingType: dispatchContext.codex?.billingType });
        return runCodex(true);
      }
      failCodex(reason);
    }
  });
  child.on('close', async (code, signal) => {
    if (!finish()) return;
    log(`exit: code=${code} signal=${signal ?? 'none'} timedOut=${timedOut}`);
    codexTokens = [...tail.matchAll(/tokens used\s+([\d,]+)/g)].pop()?.[1] ?? null;
    const telemetry = await sessionTelemetry(session, codexStartedAt, dispatchContext.codex?.billingType !== 'api');
    const diagnostics = summarizeCodexDiagnostics(telemetry.structuredErrors ?? [], stderrDiagnosticLines);
    reconnectCount = diagnostics.reconnect;
    capacityCount = diagnostics.capacity;
    reconnectLines = diagnostics.lines.filter((line) => /reconnecting|stream disconnected|retry|at capacity/i.test(line)).slice(0, 20);
    const stderrDiagnostics = stderrDiagnosticLines.join('\n');
    const structuredDiagnostics = (telemetry.structuredErrors ?? [])
      .map((entry) => typeof entry === 'string' ? entry : entry?.text).filter(Boolean);
    const failureText = [...structuredDiagnostics, stderrDiagnostics].filter(Boolean).join('\n');
    const failureTelemetry = { ...telemetry, billingType: dispatchContext.codex?.billingType,
      stderrDiagnostics,
      limit: dispatchContext.codex?.billingType === 'api' ? readCodexQuota(dispatchContext.codex, model) : readCodexLimit() };
    codexStall = { count: telemetry.stall, seconds: telemetry.stall_seconds };
    if (timedOut) return failCodex(`超时（>${config.codexTimeoutMinutes ?? 90} 分钟）`,
      { tail: '', code, telemetry: { ...failureTelemetry, structuredErrors: [] } });
    if (dispatchContext.codex?.billingType === 'api') {
      if (code !== 0) {
        logCodexFailure(failureText, code, failureTelemetry);
        const state = detectApiLimit(failureText, new Date(), config.limitCooldownMinutes ?? 60);
        if (state) {
          writeProviderLimit(dispatchContext.codex, model, state);
          return takeOverCodex(state);
        }
        return failCodex(`codex 退出码 ${code ?? 'signal ' + signal}`, { classified: true });
      }
      if (!stdout.trim()) return failCodex('codex 最终消息为空',
        { tail: '', code, telemetry: failureTelemetry });
      const previous = readCodexQuota(dispatchContext.codex, model);
      if (previous) clearCodexQuota(dispatchContext.codex, model, previous);
      log(`stdout bytes: ${stdout.length}`);
      return finishReport(stdout, codexTokens);
    }
    const snapshot = telemetry.snapshot;
    let state = snapshot ? snapshotState(snapshot, 'session', readCodexLimit()) : null;
    if (state?.type && !state.resets_at) state.resets_at = (Date.now() + (config.limitCooldownMinutes ?? 60) * 60_000) / 1000;
    if (state) writeCodexLimit(state);
    if (code !== 0) {
      logCodexFailure(failureText, code, { ...failureTelemetry, limit: state ?? failureTelemetry.limit });
      const limitUntil = detectLimit(failureText, new Date(), config.limitCooldownMinutes ?? 60);
      if (state?.type || (!snapshot && limitUntil)) {
        state ??= { last_checked_at: null, ...readCodexLimit(), type: /weekly|week limit/i.test(failureText) ? 'weekly' : /5h|5.hour/i.test(failureText) ? '5h' : 'unknown',
          resets_at: limitUntil.getTime() / 1000, detected_at: new Date().toISOString(), source: 'text', snapshot: null };
        state.last_probe_at = new Date().toISOString();
        writeCodexLimit(state);
        return takeOverCodex(state);
      }
      return failCodex(`codex 退出码 ${code ?? 'signal ' + signal}`, { classified: true });
    }
    if (!snapshot) {
      const previous = readCodexLimit();
      if (previous?.type) clearCodexLimit(previous);
    }
    if (!stdout.trim()) return failCodex('codex 最终消息为空',
      { tail: '', code, telemetry: failureTelemetry });
    log(`stdout bytes: ${stdout.length}`);
    finishReport(stdout, codexTokens);
  });
}
