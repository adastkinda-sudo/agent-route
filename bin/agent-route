    try { resumeInfo = findResume(resumeArg); }
    catch (e) { resumeError = `无法读取续跑来源 ${resumeArg}: ${e.message}`; }
  }
  if (!resumeError) {
    if (!SESSION_ID.test(resumeInfo?.session ?? '')) resumeError = `找不到 session: ${resumeArg}`;
    else if (resumeInfo.tier !== tier) resumeError = `tier 不一致: 原派发 ${resumeInfo.tier ?? '?'}，本次 ${tier}`;
    else if (cwdArg === null && !resumeInfo.cwd) resumeError = `找不到原工作目录: ${resumeArg}，请指定 --cwd`;
  }
}
