  const keys = Object.keys(data);
  if (keys.length === 0) console.log('no cooldown');
  for (const m of keys) {
    const until = activeUntil(data, m);
    console.log(until ? `${m}: cooldown until ${until.toISOString()}` : `${m}: expired (${data[m]})`);
  }
  if (context.enabled) {
    for (const app of ['codex', 'claude']) {
      const provider = safeRouteContext(context[app]);
      console.log(`${app} provider: ${provider.providerName ?? 'unknown'} (${provider.providerId ?? 'unknown'}); mode: ${provider.mode}; billing: ${provider.billingType}`);
      if (provider.diagnostics.length) console.log(`${app} diagnostics: ${provider.diagnostics.join(', ')}`);
    }
  }
  const codex = context.codex;
  if (!context.enabled || codex.billingType === 'subscription') {
    const limit = readCodexLimit();
    for (const [key, label] of [['primary', '5h'], ['secondary', 'weekly']]) {
      const window = limit?.snapshot?.[key];
      console.log(`codex ${label}: ${window ? `${window.used_percent}% resets ${fmtLocal(new Date(window.resets_at * 1000))}` : 'unknown'}`);
    }
    if (!context.enabled) console.log(`route: ${limitActive(limit) ? `Claude (codex ${limit.type} 限额${limit.resets_at ? `至 ${fmtLocal(new Date(limit.resets_at * 1000))}` : '，恢复时间未知'})` : 'Codex'}`);
  } else console.log(`codex subscription quota: ${codex.billingType === 'api' ? 'not applicable (API)' : 'unknown'}`);
  if (context.enabled) {
    for (const [tier, tierCfg] of Object.entries(config.tiers ?? {})) {
      const model = resolveCodexModel(tier, codex, tierCfg);
      const limit = readCodexQuota(codex, model);
      const until = activeUntil(data, routeStateKey('codex', codex, model));
      const quota = limitActive(limit) ? `${codex.billingType === 'api' ? 'API 服务商' : '订阅'} ${limit.type} 限额${limit.resets_at ? `至 ${fmtLocal(new Date(limit.resets_at * 1000))}` : '，恢复时间未知'}` : null;
      console.log(`codex ${tier} model: ${model}; quota: ${quota ?? (codex.billingType === 'api' ? 'available (passive detection)' : 'unknown')}`);
      console.log(`route ${tier}: ${codex.billingType === 'unknown' ? 'stopped (unknown provider/billing)' : quota || until ? `Claude (${quota ?? `cooldown until ${until.toISOString()}`})` : 'Codex'}`);
    }
  }
  const claude = context.claude;
  const claudeQuotaState = claudeQuota(config, claude);
  const weekly = claudeQuotaState.snapshot ?? claudeQuotaState.limit;
