  else if (['--cwd', '--prompt-file', '--effort', '--exclude', '--resume', '--verify', '--fix-rounds', '--progress-doc', '--label', '--commit'].includes(a)) {
    const v = argv[++i];
    if (v === undefined || v.startsWith('--')) die(`${a} 缺少参数值`);
    if (a === '--cwd') cwdArg = v;
    else if (a === '--prompt-file') promptFile = v;
