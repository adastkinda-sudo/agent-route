    const dailyRemaining = gate.line !== undefined && gate.used !== null ? Math.max(0, Math.round((gate.line - gate.used) * 10) / 10) : null;
    console.log(`claude pacing: ${gate.allowed ? 'allow' : 'block'} (${gate.reason})${gate.line !== undefined ? `; daily line ${gate.line}% from u0 ${gate.u0}%; remaining ${dailyRemaining}%` : '; daily line unknown; remaining unknown'}; urgent cap ${settings.urgentMaxPercent}%${usage ? `; observed ${usage.observed_at}` : ''}`);
  } else console.log(`claude weekly: ${claude?.billingType === 'api' ? 'not applicable (API)' : 'unknown (provider not verified)'}`);
