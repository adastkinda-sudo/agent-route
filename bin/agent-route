    else if (a === '--verify') {
      if (!v.trim()) die('--verify 命令不能为空');
      verifyCommands.push(v);
    }
    else if (a === '--fix-rounds') {
      if (!/^\d+$/.test(v) || !Number.isSafeInteger(Number(v))) die('--fix-rounds 只能是非负整数');
      fixRounds = Number(v);
    }
    else if (EFFORTS.includes(v)) effortArg = v;
    else die(`--effort 只能是 ${EFFORTS.join(' / ')}`);
