    const model = resolveCodexModel(tier, context.codex, tierCfg);
    const state = readCodexQuota(context.codex, model);
    if (state) clearCodexQuota(context.codex, model, state);
  }
  console.log('cooldown cleared');
  process.exit(0);
}

