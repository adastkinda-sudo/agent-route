function collectRouteSecrets(value, key = '') {
  if (typeof value === 'string') {
    if (value.length >= 4 && (/(?:key|token|secret|bearer|password|auth|base_url|endpoint)/i.test(key) || /^https?:\/\//i.test(value))) {
      redactions.add(value);
    }
    return;
  }
  if (!value || typeof value !== 'object') return;
  for (const [childKey, childValue] of Object.entries(value)) collectRouteSecrets(childValue, childKey);
}
collectRouteSecrets(dispatchContext.codex?.credentials);
for (const [key, value] of Object.entries(process.env)) collectRouteSecrets(value, key);
for (const fallback of dispatchContext.codexFallbacks ?? []) {
  collectRouteSecrets(fallback.runtime?.key, 'key');
  collectRouteSecrets(fallback.runtime?.baseUrl, 'base_url');
}
redactSecrets = (value) => {
  let text = String(value ?? '');
  for (const secret of redactions) if (secret) text = text.split(secret).join('[redacted]');
  return text
    .replace(/(Bearer\s+)[^\s\r\n]+/gi, '$1[redacted]')
    .replace(/((?:OPENAI|CODEX|ANTHROPIC|AGENT_ROUTE_PROVIDER)[A-Z_]*(?:KEY|TOKEN|SECRET)\s*[=:]\s*)([^\s,}\]"']+)/gi, '$1[redacted]');
};
function appendLog(value) {
  try { fs.appendFileSync(logPath, redactSecrets(value)); } catch {}
}
const log = (s) => {
  const text = redactSecrets(s);
  appendLog(text.endsWith('\n') ? text : text + '\n');
};
// macOS 系统通知；测试通过 AGENT_ROUTE_NOTIFY_FILE 改为写文件，不弹出通知。通知失败不影响派发。
function notify(event, message) {
  log(`notify: ${event}`);
  try {
    if (process.env.AGENT_ROUTE_NOTIFY_FILE) {
      fs.appendFileSync(process.env.AGENT_ROUTE_NOTIFY_FILE, JSON.stringify({ event, message: redactSecrets(message) }) + '\n');
    } else if (process.platform === 'darwin') {
      spawnSync('osascript', ['-e', 'on run argv\ndisplay notification (item 2 of argv) with title (item 1 of argv)\nend run',
        `agent-route: ${event}`, redactSecrets(message)], { timeout: 5000, stdio: 'ignore' });
    }
  } catch { /* 通知只是提示 */ }
}
// 同一事件每次派发最多一条；repeatMinutes 给定时，还要求距上一次通知超过该间隔或已跨自然日（状态在 notify-state.json）。
const notifiedEvents = new Set();
function notifyOnce(event, message, { repeatMinutes = null } = {}) {
  if (notifiedEvents.has(event)) return false;
  notifiedEvents.add(event);
  if (repeatMinutes !== null) {
    const file = path.join(STATE_DIR, 'notify-state.json');
    const due = withRouteLockSync(() => {
      const state = readJsonFile(file, {});
      const last = Date.parse(state[event]);
      const now = Date.now();
      if (Number.isFinite(last) && now - last < repeatMinutes * 60_000 && todayKey() === new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Singapore' }).format(new Date(last))) return false;
      writeJsonAtomic(file, { ...state, [event]: new Date(now).toISOString() });
      return true;
    });
    if (!due) { log(`notify skipped: ${event} (repeat < ${repeatMinutes}m)`); return false; }
  }
  notify(event, message);
  return true;
}
