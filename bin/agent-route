    ? `${weekly.used_percent}% resets ${fmtLocal(new Date(weekly.resets_at * 1000))}` : 'unknown (passive detection)'}`);
  console.log(`claude weekly threshold: ${config.claudeWeeklyThreshold ?? 80}%; cooldown: ${claudeQuotaState.limit
    ? `until ${new Date(claudeQuotaState.limit.resets_at * 1000).toISOString()}` : 'none'}`);
  for (const tier of Object.keys(config.tiers ?? {})) {
    const selected = resolveClaudeModel(tier, claude, config);
    console.log(`claude ${tier} model: ${selected.model}; effort: ${selected.effort}`);
  }
  const monitorModel = resolveClaudeModel('tier2', claude, config, { monitor: true });
  console.log(`claude monitor model: ${monitorModel.model}; effort: ${monitorModel.effort}`);
  process.exit(0);
}
