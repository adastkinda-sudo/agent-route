  fs.writeFileSync(path.join(cwd, 'ignored', 'commit.txt'), 'ignored\n');
}
if (scenario === 'ignored-write') {
  for (const dir of ['ignored', 'excluded']) {
    fs.mkdirSync(path.join(cwd, dir), { recursive: true });
    fs.writeFileSync(path.join(cwd, dir, 'written.txt'), 'stub write\n');
  }
}
if (scenario === 'pycache') {
  fs.mkdirSync(path.join(cwd, '__pycache__'), { recursive: true });
  fs.writeFileSync(path.join(cwd, '__pycache__', 'selftest.pyc'), 'stub bytecode\n');
}

const failure = scenario === 'failure' || (scenario === 'fix-failure' && repair) || (scenario === 'claude-fixable' && !claude);
const status = scenario === 'partial' || (scenario === 'fix-partial' && repair) ? '部分完成' : failure ? '未完成' : '完成';
const report = scenario === 'monitor' ? 'STATUS: OK\nselftest monitor\n' : [
  ...(scenario === 'unknown' ? [] : [`状态: ${status}`]),
  ...(/^模式: 只读，除报告文件 /m.test(prompt) && scenario !== 'missing-conclusion'
    ? scenario === 'empty-conclusion' ? ['结论:', '  -   ']
      : scenario === 'conclusions' ? ['结论:', '  - 入口会校验输入；依据: src/router.js:route',
        '    说明: 保留  两个空格与换行。', '',
        `  - ${'调查🧪'.repeat(70)}；依据: rg entry → 2 matches`,
        '  - 错误分支会返回失败；依据: src/router.js:catchError']
      : ['结论:', '  - 调查入口正常；依据: codex-stub → 完成'] : []),
  ...(scenario === 'progress-details' ? ['改动文件:',
    ...Array.from({ length: 10 }, (_, i) => `  - ${i === 0 ? `${cwd}/` : ''}file-${i + 1}.txt`)] : scenario === 'compact-details'
    ? ['改动文件:', `  - ${cwd}/first.txt`, `  - ${'界🧪'.repeat(110)}.txt`] : ['改动文件: 无']),
  ...(scenario === 'compact-details' ? ['验证:', `  - ${'验🧪'.repeat(70)} → PASS`, '  - 第二项 → PASS'] : ['验证: codex-stub → 完成']),
  ...(session ? [`  - resume session: ${session}`, `  - resume cwd: ${processCwd}`] : []),
  ...(['fixable', 'fix-twice', 'claude-fixable'].includes(scenario) ? [`  - round: ${round}`] : []),
  ...(scenario === 'paths' ? [`  - cwd: ${cwd}`, `  - cwd-slash: ${cwd}/`, `  - file: ${cwd}/nested/a.txt`, `  - sibling: ${cwd}-other/a.txt`,
    `  - logs-dir: ${path.dirname(reportPath)}`, `  - logs: ${path.dirname(reportPath)}/artifact.log`, `  - report: ${reportPath}`] : []),
  ...(scenario === 'compact-details' ? [] : [
    ['progress-details', 'deviation'].includes(scenario) ? '偏差: 使用测试替身' : scenario === 'report-warning' ? '偏差: WARNING selftest' :
      scenario === 'empty-notes' ? '偏差:' : '偏差: 无',
    ...(scenario === 'progress-details' ? ['遗留问题:', '  - 等待检查', '  - 补充资料'] :
      [scenario === 'pending' ? '遗留问题: 等待检查' : '遗留问题: 无']),
  ]),
  '',
].join('\n');
if (claude) {
  process.stdout.write(JSON.stringify({ is_error: false, result: report, session_id: currentSession,
    usage: { input_tokens: 1000, output_tokens: 234 }, modelUsage: { 'selftest-claude': {} }, total_cost_usd: 0 }),
    () => process.exit(failure ? 1 : 0));
} else {
  fs.writeFileSync(output, report);
  process.stdout.write([
    'OpenAI Codex (selftest stub)',
    '--------',
    `workdir: ${cwd}`,
    `session id: ${currentSession}`,
    '--------',
    `SELFTEST_STUB_TRACE: ${scenario}`,
    'codex',
    report.trimEnd(),
    'tokens used',
    '1,234',
    '',
  ].join('\n'), () => process.exit(failure ? 1 : 0));
}
