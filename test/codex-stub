  fs.writeSync(2, 'stream disconnected; Retry 1/5\nAT CAPACITY; retry later\nat capacity\nReConnec');
  await new Promise((resolve) => setTimeout(resolve, 20));
  fs.writeSync(2, 'ting 2/5');
}
