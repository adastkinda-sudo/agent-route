  let settings = {};
  try { settings = JSON.parse(fs.readFileSync(path.join(configDir, 'settings.json'), 'utf8')); } catch {}
  const model = option('--model');
  const modelEnv = `ANTHROPIC_DEFAULT_${model.toUpperCase()}_MODEL`;
  const agent = agents[option('--agent')];
  if (!agent || agent.model !== 'inherit') die('agent model 未继承本次解析模型');
  fs.appendFileSync(path.join(isolation.home, 'stub-claude-invocations.jsonl'), JSON.stringify({ model,
    effectiveModel: settings.env?.[modelEnv] ?? model, effort: option('--effort'), configDir,
    customConfigDir: process.env.CLAUDE_CONFIG_DIR ?? null, envKeys: Object.keys(process.env), agentRouteDepth: process.env.AGENT_ROUTE_DEPTH ?? null, agent,
    session: args.includes('--resume') ? option('--resume') : null }) + '\n');
}
if (args[0] === 'app-server') {
  const settingsPath = path.join(process.env.HOME, 'stub-rate-limits.json');
