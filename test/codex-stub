catch { die('缺少隔离环境'); }
if (process.env.HOME !== isolation.home ||
  (process.env.CODEX_HOME ?? path.join(process.env.HOME, '.codex')) !== isolation.codexHome ||
  !fs.realpathSync(process.cwd()).startsWith(isolation.root + path.sep)) die('selftest 目录未隔离');
