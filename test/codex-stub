  const configDir = process.env.CLAUDE_CONFIG_DIR ?? path.join(isolation.home, '.claude');
  if (!path.resolve(configDir).startsWith(isolation.home + path.sep) ||
    Object.keys(process.env).some((key) => /^(ANTHROPIC_|CLAUDE_CODE_|CODEX_|AGENT_ROUTE_)/.test(key) && key !== 'AGENT_ROUTE_DEPTH')) die('Claude 环境未隔离');
  if (args[0] === 'auth') {
    if (args.join(' ') !== 'auth status') die('只支持 auth status');
    let status = { loggedIn: false, authMethod: 'none' };
    try { status = JSON.parse(fs.readFileSync(path.join(isolation.home, 'stub-claude-auth.json'), 'utf8')); } catch {}
    if (status.delayMs) await new Promise((resolve) => setTimeout(resolve, status.delayMs));
    process.stdout.write(JSON.stringify({ apiProvider: 'firstParty', configDirectory: configDir, ...status }));
