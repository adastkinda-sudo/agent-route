  if (args.includes('stream-json')) {
    // 用量探测：stub-claude-usage.json 的 { five_hour, seven_day } 原样放进 rate_limit_event.unifiedWindows；缺失时不发事件。
    let usage = null;
    try { usage = JSON.parse(fs.readFileSync(path.join(isolation.home, 'stub-claude-usage.json'), 'utf8')); } catch {}
    fs.appendFileSync(path.join(isolation.home, 'stub-claude-probes.jsonl'), JSON.stringify({ args: args.slice(0, 4), configDir }) + '\n');
    const events = [{ type: 'system', subtype: 'init' },
      ...(usage ? [{ type: 'rate_limit_event', rate_limit_info: { status: 'allowed', unifiedWindows: usage } }] : []),
      { type: 'result', subtype: 'success', is_error: false, result: 'ok' }];
    process.stdout.write(events.map((event) => JSON.stringify(event)).join('\n') + '\n', () => process.exit(0));
