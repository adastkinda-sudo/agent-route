  fs.writeFileSync(path.join(directory, `rollout-test-${currentSession}.jsonl`), records.map(JSON.stringify).join('\n') + '\n{"unfinished":');
}
// codex-fail-N：前 N 次 Codex 调用失败（续跑、重试和新线程都计数），之后及 Claude 调用成功。
