  'paths', 'fixable', 'fix-twice', 'fix-failure', 'fix-partial', 'claude-fixable',
  'progress-details', 'commit-mixed', 'report-warning', 'compact-details', 'deviation', 'pending', 'empty-notes',
  'conclusions', 'missing-conclusion', 'empty-conclusion', 'limit', 'limit-notime',
  'limit-session', 'limit-weekly', 'limit-reached', 'limit-partial', 'limit-both', 'limit-both-zero', 'limit-both-api',
  'complete-snapshot', 'metadata-healthy-error', 'premium-only', 'api-complete-snapshot', 'api-429-snapshot',
  'api-429', 'api-429-date', 'api-429-reset', 'api-quota', 'api-401', 'api-model', 'api-network', 'api-limit-both',
  'stream-events', 'stream-many', 'false-diagnostics', 'structured-capacity', 'stall-events', 'stall-high', 'stall-missing', 'micu-fallback'].includes(scenario) && !/^route:[a-z0-9@]+:[a-z0-9]+$/.test(scenario ?? '') && !failFirst) {
  die(`未知场景: ${scenario ?? '(无)'}`);
}
const currentSession = session ?? randomUUID();
