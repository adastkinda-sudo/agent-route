      const { idempotencyKey, creditId } = request.params ?? {};
      if (typeof idempotencyKey !== 'string' || !idempotencyKey) die('consume 缺少 idempotencyKey');
      fs.appendFileSync(path.join(process.env.HOME, 'stub-app-server.jsonl'), JSON.stringify({ event: 'consume', idempotencyKey, creditId: creditId ?? null }) + '\n');
      if (settings.consumeMode === 'error') return reply({ id: request.id, error: { code: -32000, message: 'consume failed' } });
      if (settings.consumeMode === 'hang') return;
      const outcome = settings.consumeOutcome ?? 'reset';
      if (outcome === 'reset' && settings.consumeEffect !== 'none') {
        // 重置生效：两个窗口回到 0，被用掉的券不再可用，official 路由的 limit 场景从此成功。
        const next = { ...settings, primaryUsed: 0, weeklyUsed: 0, recovered: true,
          credits: (settings.credits ?? []).filter((credit) => credit.id !== creditId) };
        fs.writeFileSync(settingsPath, JSON.stringify(next));
        settings = next;
      }
      reply({ id: request.id, result: { outcome } });
    } else die(`未知方法 ${request.method}`);
  });
