  const records = [event(-86400, 0, 0), event(-86300, 10, 10), event(0, 1000, 990),
    event(60, scenario === 'stall-high' ? 1500 : 1499, 499),
    event(119, 1500, 1), event(209, 1500, 499), event(269, 2000, 0),
    { timestamp: new Date(time + 329000).toISOString(), type: 'response_item', payload: { content: 'SELFTEST_PRIVATE_DIALOGUE' } },
    event(330, 2001, 1)];
